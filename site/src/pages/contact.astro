---
import MemoLayout from '../layouts/MemoLayout.astro';
import { links } from '../data/links';
---
<MemoLayout
  title="Contact"
  description="Contact Colton Bearden: inbox@coltonbearden.com, or on GitHub, LinkedIn and Instagram."
  kicker="Contact"
>
  <p>
    Email is the best way to reach me, and I read every message myself.
  </p>
  <table class="doc-table">
    <thead>
      <tr><th scope="col">Channel</th><th scope="col">Address</th><th scope="col">Good for</th></tr>
    </thead>
    <tbody>
      <tr><td>Email</td><td><a href="mailto:inbox@coltonbearden.com">inbox@coltonbearden.com</a></td><td>Anything. SPF, DKIM and DMARC are in order, so replies arrive.</td></tr>
      {links.map((l) => (
        <tr><td>{l.label}</td><td><a href={l.href} rel="me">{l.handle}</a></td><td>{l.goodFor}</td></tr>
      ))}
    </tbody>
  </table>
</MemoLayout>
