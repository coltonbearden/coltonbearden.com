---
import MemoLayout from '../layouts/MemoLayout.astro';
import featured from '../data/catalog.json';
import { projects } from '../data/projects';
import snapshot from '../data/repos.json';
import { featuredRepos, repoMeta } from '../utils/catalog';

const statusLabel = {
  active: 'Active',
  'in-development': 'In development',
} as const;

const repos = featuredRepos(featured, snapshot);
---
<MemoLayout
  title="Work"
  description="Selected projects by Colton Bearden: this site and its domain operations, a six-machine homelab fleet, and public repositories on GitHub."
  kicker="Work"
>
  <p>
    Some of these are finished and some aren't. Both kinds are listed,
    because an honest ledger is more useful than a polished one.
  </p>
  {projects.map((p) => (
    <section>
      <h2>{p.title} <span class="stamp">{statusLabel[p.status]}</span></h2>
      <p>{p.summary}</p>
      <ul>
        {p.details.map((d) => <li>{d}</li>)}
      </ul>
      {p.link && <p><a href={p.link.href}>{p.link.label} →</a></p>}
    </section>
  ))}
  <section>
    <h2>Public repositories</h2>
    <ul class="directory">
      {repos.map((r) => (
        <li>
          <a href={r.html_url}>{r.full_name.split('/')[1]}</a> <span class="dir-route">{repoMeta(r)}</span>
          {r.description && <><br />{r.description}</>}
        </li>
      ))}
    </ul>
  </section>
</MemoLayout>
