---
import MemoLayout from '../layouts/MemoLayout.astro';

const fleet = [
  { name: 'AMD 9950X desktop (RTX 5070 Ti, 96 GB DDR5)', os: 'Windows 11 Pro', role: 'Primary workstation' },
  { name: 'NVIDIA DGX Spark', os: 'Ubuntu', role: 'Local AI and ML workloads' },
  { name: 'ThinkPad T14 Gen 6', os: 'Windows 11 Pro', role: 'Mobile workstation' },
  { name: 'ASUS NUC 15 Pro+', os: 'Ubuntu', role: 'Linux server' },
  { name: 'Minisforum X1 Pro-370', os: 'Ubuntu', role: 'Linux mini PC' },
  { name: 'Minisforum X1-255', os: 'Ubuntu', role: 'Linux mini PC' },
];

const toolchain = [
  { area: 'Shell & terminal', items: 'PowerShell 7, Windows Terminal, Oh My Posh' },
  { area: 'Editors', items: 'VS Code (curated 33-extension keep-list), Sublime Text as git editor' },
  { area: 'Runtimes', items: 'Node 24 + pnpm via corepack, Python 3.13 managed by uv, .NET, Rust' },
  { area: 'Git', items: 'Git + delta side-by-side pager, GitHub CLI, Conventional Commits, HTTPS over SSH' },
  { area: 'CLI daily carry', items: 'ripgrep, fd, fzf, bat, eza, jq, zoxide, hyperfine, tokei, pandoc, ImageMagick' },
  { area: 'AI', items: 'Claude Code (native install, latest channel), which drives most of the work written up in Notes' },
];
---
<MemoLayout
  title="Uses"
  description="The hardware and daily toolchain behind coltonbearden.com: six machines on a private mesh, PowerShell 7, uv, pnpm, and a modern CLI kit."
  kicker="Uses"
>
  <p>
    Six machines on a private mesh network, plus the tools I use every day.
  </p>
  <h2>Hardware</h2>
  <table class="doc-table">
    <thead>
      <tr><th scope="col">Machine</th><th scope="col">OS</th><th scope="col">Role</th></tr>
    </thead>
    <tbody>
      {fleet.map((m) => (
        <tr><td>{m.name}</td><td>{m.os}</td><td>{m.role}</td></tr>
      ))}
    </tbody>
  </table>
  <h2>Toolchain</h2>
  <table class="doc-table">
    <thead>
      <tr><th scope="col">Area</th><th scope="col">Tools</th></tr>
    </thead>
    <tbody>
      {toolchain.map((t) => (
        <tr><td>{t.area}</td><td>{t.items}</td></tr>
      ))}
    </tbody>
  </table>
  <p>
    A few habits: global site-packages stay lean (tools go in with
    <code>uv tool install</code>), system packages come from winget, and
    every installation has to justify itself.
  </p>
</MemoLayout>
