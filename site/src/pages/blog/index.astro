---
import { getCollection } from 'astro:content';
import MemoLayout from '../../layouts/MemoLayout.astro';
import { assertUniqueEditions, byEditionDesc } from '../../utils/posts';

const posts = byEditionDesc(assertUniqueEditions(await getCollection('posts')));
---
<MemoLayout
  title="Notes"
  description="Notes and write-ups by Colton Bearden, newest first."
  kicker="Notes"
>
  <p>
    Write-ups of what I build and run, newest first. New notes are
    announced by <a href="/rss.xml">RSS</a>.
  </p>
  <ul class="directory">
    {posts.map((p) => (
      <li>
        <a href={`/blog/${p.id}/`}>{p.data.title}</a>
        <span class="dir-route">{p.data.pubDate.toISOString().slice(0, 10)}</span>
        <p>{p.data.description}</p>
      </li>
    ))}
  </ul>
</MemoLayout>
