---
import BaseLayout from './BaseLayout.astro';

interface Props { title: string; description: string; kicker: string }
const { title, description, kicker } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <article class="memo">
    <p class="memo-kicker">{kicker}</p>
    <h1>{title}</h1>
    <slot />
  </article>
</BaseLayout>
