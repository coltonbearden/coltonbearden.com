{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coltonbearden-com",
  "compatibility_date": "2026-09-03",
  // The site is served only on its custom domains; the workers.dev route stays off (D25).
  "workers_dev": false,
  // Explicit, so PR preview URLs survive a Worker recreate: when omitted, a new Worker's
  // preview_urls default follows workers_dev.
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
